#!/bin/bash
HERE="$(dirname "$(readlink -f "$0")")"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zelda3"
SAVE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zelda3"
mkdir -p "$CONFIG_DIR" "$SAVE_DIR"

APPIMAGE_DIR="${APPDIR:-$(dirname "$APPIMAGE")}"

# Default config
[ ! -f "$CONFIG_DIR/zelda3.ini" ] && cp "$HERE/zelda3.ini" "$CONFIG_DIR/"

# Look for ROM next to the AppImage, then in config dir, home
ROM_PATH=""
for dir in "$APPIMAGE_DIR" "$CONFIG_DIR" "$(pwd)" "$HOME"; do
    [ -f "$dir/zelda3.sfc" ] && ROM_PATH="$dir/zelda3.sfc" && break
    [ -f "$dir/zelda3.smc" ] && ROM_PATH="$dir/zelda3.smc" && break
done
if [ -n "$ROM_PATH" ] && [ ! -f "$CONFIG_DIR/zelda3.sfc" ] && [ ! -f "$CONFIG_DIR/zelda3.smc" ]; then
    cp "$ROM_PATH" "$CONFIG_DIR/"
fi

# Extract assets on first run
if [ ! -f "$CONFIG_DIR/zelda3_assets.dat" ] && [ -f "$CONFIG_DIR/zelda3.sfc" ]; then
    echo "Extracting game assets on first run..."

    # Set up a persistent venv for Python deps so extraction works offline
    VENV_DIR="$CONFIG_DIR/.venv"
    if [ ! -f "$VENV_DIR/bin/python3" ]; then
        echo "Setting up Python environment..."
        python3 -m venv "$VENV_DIR" 2>/dev/null || true
    fi
    ROM_FILE="$CONFIG_DIR/zelda3.sfc"
    if [ -f "$VENV_DIR/bin/python3" ]; then
        "$VENV_DIR/bin/pip" install --quiet pillow pyyaml 2>/dev/null
        (cd "$CONFIG_DIR" && PYTHONPATH="$HERE/assets" "$VENV_DIR/bin/python3" "$HERE/assets/restool.py" --extract-from-rom --rom "$ROM_FILE")
    else
        python3 -m pip install --user pillow pyyaml 2>/dev/null || true
        (cd "$CONFIG_DIR" && PYTHONPATH="$HERE/assets" python3 "$HERE/assets/restool.py" --extract-from-rom --rom "$ROM_FILE")
    fi

    # compile_resources writes ../zelda3_assets.dat relative to CWD
    [ -f "$CONFIG_DIR/../zelda3_assets.dat" ] && mv "$CONFIG_DIR/../zelda3_assets.dat" "$CONFIG_DIR/zelda3_assets.dat"

    if [ ! -f "$CONFIG_DIR/zelda3_assets.dat" ]; then
        echo ""
        echo "Automatic extraction failed. Run these commands manually:"
        echo "  pip install --user pillow pyyaml"
        echo "  cd $CONFIG_DIR"
        echo "  python3 restool.py --extract-from-rom"
        echo ""
    fi
fi

# Link bundled shaders and sprites into config dir so relative paths resolve
[ -d "$HERE/glsl-shaders" ] && [ ! -e "$CONFIG_DIR/glsl-shaders" ] && ln -s "$HERE/glsl-shaders" "$CONFIG_DIR/glsl-shaders"
[ -d "$HERE/sprites-gfx" ] && [ ! -e "$CONFIG_DIR/sprites-gfx" ] && ln -s "$HERE/sprites-gfx" "$CONFIG_DIR/sprites-gfx"

cd "$CONFIG_DIR"
exec "$HERE/zelda3" "$@"
