#!/bin/bash
HERE="$(dirname "$(readlink -f "$0")")"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zelda3"
SAVE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zelda3"
mkdir -p "$CONFIG_DIR" "$SAVE_DIR"

APPIMAGE_DIR="${APPDIR:-$(dirname "$APPIMAGE")}"

# Default config
[ ! -f "$CONFIG_DIR/zelda3.ini" ] && cp "$HERE/zelda3.ini" "$CONFIG_DIR/"

# Look for ROM next to the AppImage, then in config dir, home
ROM_PATH=""
for dir in "$APPIMAGE_DIR" "$CONFIG_DIR" "$(pwd)" "$HOME"; do
    [ -f "$dir/zelda3.sfc" ] && ROM_PATH="$dir/zelda3.sfc" && break
    [ -f "$dir/zelda3.smc" ] && ROM_PATH="$dir/zelda3.smc" && break
done
if [ -n "$ROM_PATH" ] && [ ! -f "$CONFIG_DIR/zelda3.sfc" ] && [ ! -f "$CONFIG_DIR/zelda3.smc" ]; then
    cp "$ROM_PATH" "$CONFIG_DIR/"
fi

# Extract assets on first run using bundled Python deps
if [ ! -f "$CONFIG_DIR/zelda3_assets.dat" ] && [ -f "$CONFIG_DIR/zelda3.sfc" ]; then
    echo "Extracting game assets on first run..."
    if [ -d "$HERE/python-deps" ]; then
        (cd "$CONFIG_DIR" && PYTHONPATH="$HERE/python-deps:$HERE/assets" python3 "$HERE/assets/restool.py" --extract-from-rom)
    else
        (cd "$CONFIG_DIR" && PYTHONPATH="$HERE/assets" python3 "$HERE/assets/restool.py" --extract-from-rom) 2>/dev/null
    fi

    if [ ! -f "$CONFIG_DIR/zelda3_assets.dat" ]; then
        echo ""
        echo "Automatic extraction failed. Install Python deps and run:"
        echo "  pip install --user pillow pyyaml"
        echo "  cd $CONFIG_DIR && python3 restool.py --extract-from-rom"
        echo ""
    fi
fi

cd "$CONFIG_DIR"
exec "$HERE/zelda3" "$@"
