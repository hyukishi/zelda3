FROM ubuntu:22.04 AS builder

RUN apt-get update && apt-get install -y \
    build-essential \
    libsdl2-dev \
    python3 \
    python3-pip \
    file \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install pillow pyyaml

WORKDIR /src

# Copy all source files (the build context should exclude venv/ .git/ *.o)
COPY . .

# Build the game binary (without asset extraction - needs ROM)
RUN make -j$(nproc) zelda3 && \
    file /src/zelda3 && \
    ldd /src/zelda3
